{
    "name": "the-pessimist",
    "version": "1.0.0",
    "private": true,
    "description": "A pre-mortem content analysis tool. Assume it fails before you publish.",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "node scripts/e2e-check.mjs",
        "check:readme": "tsx scripts/check-readme.ts",
        "test:critics": "tsx scripts/test-critic.ts",
        "test:critics:mock": "tsx scripts/test-critic.ts --mock",
        "mock:provider": "node scripts/mock-provider.mjs",
        "demo:record": "node scripts/record-demo.mjs"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "geist": "^1.5.1",
        "localforage": "^1.10.0",
        "lucide-react": "^0.468.0",
        "next": "15.5.28",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "tailwind-merge": "^2.6.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.24.0",
        "eslint-config-next": "15.5.28",
        "playwright-core": "^1.64.1",
        "postcss": "^8.5.3",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3",
        "vitest": "^3.0.9"
    }
}
