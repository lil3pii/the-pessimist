# Optional. The app is BYOK and needs no server-side key.
# Only used by the CLI critic harness and integration tests.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Self-hosted testing only. Allows the stateless proxy to call loopback/local
# OpenAI-compatible servers. Never enable this on a public deployment.
ALLOW_LOCAL_PROVIDER_PROXY=false
